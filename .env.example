# .env.example
# ──────────────────────────────────────────────────────────────
# Plantilla de referencia — NO contiene valores reales.
# Las variables reales se configuran directamente en el panel de
# Netlify: Site settings → Environment variables. Nunca se suben
# a este repositorio con su valor real.
# ──────────────────────────────────────────────────────────────

# Secreto compartido para el link protegido de descarga de artwork
# (netlify/functions/get-artwork.mjs). Genera un valor largo y
# aleatorio — por ejemplo, con: openssl rand -hex 32
# Este secreto NUNCA va en el frontend ni en shopify.config.js.
ARTWORK_ACCESS_SECRET=

# Nota: el Public Storefront Access Token de Shopify NO va aquí.
# Ese vive intencionalmente en shop/shopify.config.js porque está
# diseñado por Shopify para ser público en el navegador (ver los
# comentarios de ese archivo). Solo el ARTWORK_ACCESS_SECRET de
# arriba es un secreto real de servidor.
